# Secrets / personal
*.pem
*.key
*.crt
.env
.envrc
# Accidentally-saved SSH private keys (e.g. from `ssh -i ec2-user@host ...` typos)
ec2-user@*
ubuntu@*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# Claude Code local settings (user-specific)
.claude/settings.local.json

# Python / OS
__pycache__/
*.pyc
.DS_Store
*.swp
